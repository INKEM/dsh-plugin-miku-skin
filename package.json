{
  "name": "dsh-plugin-miku-skin",
  "version": "1.0.0",
  "description": "Hatsune Miku-inspired dark skin for the DSH Web GUI, drawn only with geometry, characters, and color — no image assets.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "src",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "skin.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "theme",
    "skin",
    "miku"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "check": "node scripts/build.mjs && node --check lib/client.js && node --check lib/index.js && node scripts/verify.mjs"
  },
  "license": "MIT"
}
